PORT=3001
MONGODB_URI=mongodb://app_user:app_password@127.0.0.1:27017/eastman-polybags?authSource=eastman-polybags
CLIENT_ORIGIN=http://localhost:8000
MUTATION_RATE_LIMIT_MAX=120
TRUST_PROXY=false
DEV_RESET_DB_KEY=change-this-local-only

# --- Railway deployment env vars ---
# PORT         Railway sets this automatically — do not override
# MONGODB_URI  Paste the connection string from MongoDB Atlas (or Railway MongoDB plugin)
# CLIENT_ORIGIN  Set to your Railway app URL e.g. https://your-app.up.railway.app
# TRUST_PROXY  Set to 1 on Railway (runs behind a reverse proxy)
# JWT_SECRET   Set to a long random string (openssl rand -hex 32)
# REFRESH_SECRET  Set to a different long random string
# ADMIN_EMAIL  Email for the auto-created admin account on first boot
